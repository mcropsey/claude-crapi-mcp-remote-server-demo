# crapi-mcp environment — edit values, keep this file out of version control.
# Loaded by the systemd unit via EnvironmentFile.
#
# Typical layout: this MCP server runs on its own box (e.g. 192.168.1.102) and
# reaches crAPI over the network on another box (e.g. 192.168.1.101:8888).
# Single-box is fine too — just point CRAPI_BASE at wherever crAPI listens.

# Where crAPI is reachable FROM this box.
# This is the ONE place the target URL is configured — server.py reads it from
# here and has no hardcoded fallback, so you never have to touch the code.
# NOTE: no trailing slash — paths are appended directly (the server also strips
# one defensively, but keep it clean here).
CRAPI_BASE=https://crapi.cropseyit.com

# Listen address/port for this MCP server.
# 8009 is used (not 8000) to stay clear of common defaults like chromadb/8000.
MCP_HOST=0.0.0.0
MCP_PORT=8009
MCP_PATH=/mcp

# Optional: require clients to send  Authorization: Bearer <value>  to the MCP
# endpoint. Strongly recommended so only you can drive the attack tools.
# Generate one with:  openssl rand -hex 24
# MCP_AUTH_TOKEN=change-me-to-a-long-random-string

# Optional: pre-seed a crAPI session token. Usually leave this blank and just
# call the `login` tool from Claude — it stores the token in memory at runtime.
# CRAPI_TOKEN=

# ── Sensor / Inventory identity (IMPORTANT) ─────────────────────────────────────
# The API sensor (Noname) keys Inventory identity off the mcp-session-id the
# server advertises. If that value changes, the sensor treats this as a brand-new
# MCP server and DROPS the old record and all its tools. server.py mints a random
# id when this is unset, so a restart/reboot changed the id and made your MCP
# entry (and its 28 tools) disappear. Pin it here so it survives restarts.
#
# The value below was generated once (openssl rand -hex 16 / uuidgen). Keep it
# stable — do not regenerate unless you intentionally want a fresh Inventory entry.
MCP_SESSION_ID=dda4790c468c411384ab60193d50bed4

# Where server.py persists a minted id if MCP_SESSION_ID above is left blank.
# (Belt-and-suspenders: even without the env var, the id then survives restarts.)
# MCP_SESSION_ID_FILE=/opt/crapi-mcp/.mcp_session_id

# Protocol version advertised on the initialize handshake when the client doesn't
# send its own MCP-Protocol-Version header. Only change if your client negotiates
# a different version.
# MCP_PROTOCOL_VERSION=2025-06-18
